# Compose-only settings. Copy to .env.docker for local runs; never commit real values.
WEB_PORT=8081
API_ENV_FILE=./server/.env.docker.example
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=your_database_name
VITE_MAIN_APP_ORIGIN=http://localhost:8081
VITE_ADMIN_APP_ORIGIN=http://localhost:8081
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
CLIENT_ORIGINS=http://localhost:8081
ADMIN_ORIGINS=http://localhost:8081
AI_CORS_ORIGINS=http://localhost:8081

# Optional tags for deployment (prefer registry/release SHA tags in production).
WORKCLOUD_WEB_IMAGE=workcloud-web:local
WORKCLOUD_API_IMAGE=workcloud-api:local
WORKCLOUD_AI_IMAGE=workcloud-ai:local
