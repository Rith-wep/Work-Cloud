PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=your_database_name
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_ORIGINS=https://admin.workcloud.com
SUPER_ADMIN_EMAILS=founder@workcloud.com
MODERATOR_EMAILS=ops@workcloud.com
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
GEMINI_API_KEY=your_gemini_api_key

# Verification payment URLs
MAIN_APP_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Bakong KHQR verification
BAKONG_ACCOUNT_ID=your_bakong_account_id
BAKONG_MERCHANT_ID=your_bakong_merchant_id
BAKONG_MERCHANT_NAME=Linklid
BAKONG_MERCHANT_CITY=PHNOM PENH
BAKONG_ACQUIRING_BANK=your_acquiring_bank
BAKONG_MOBILE_NUMBER=
BAKONG_STORE_LABEL=Linklid
BAKONG_TERMINAL_LABEL=Verification
BAKONG_MERCHANT_CATEGORY_CODE=5999
BAKONG_EXPIRATION_MINUTES=15
BAKONG_KHQR_IMAGE=
BAKONG_CALLBACK_URL=http://localhost:5000/api/payments/verification/bakong/callback
BAKONG_BEARER_TOKEN=your_bakong_bearer_token
