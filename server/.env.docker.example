# Copy to server/.env.docker and replace placeholders. This file is loaded at runtime only.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=your_database
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
JWT_EXPIRES_IN=7d
SUPER_ADMIN_EMAILS=admin@example.com
MODERATOR_EMAILS=ops@example.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
GEMINI_API_KEY=your_gemini_key
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_ID=
BAKONG_MERCHANT_NAME=WorkCloud
BAKONG_MERCHANT_CITY=PHNOM PENH
BAKONG_ACQUIRING_BANK=
BAKONG_MOBILE_NUMBER=
BAKONG_STORE_LABEL=WorkCloud
BAKONG_TERMINAL_LABEL=Verification
BAKONG_MERCHANT_CATEGORY_CODE=5999
BAKONG_EXPIRATION_MINUTES=15
BAKONG_KHQR_IMAGE=
BAKONG_CALLBACK_URL=http://localhost:8080/api/payments/verification/bakong/callback
BAKONG_BEARER_TOKEN=
BAKONG_CHECK_TRANSACTION_URL=https://api-bakong.nbc.org.kh/v1/check_transaction_by_md5
